---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Hide drafts, newest first
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout>
	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}
					</time>
					<h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
					{post.data.description && <p>{post.data.description}</p>}
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; }
	h2 { margin: 0.1rem 0 0.25rem; font-size: 1.35rem; }
	h2 a { color: inherit; text-decoration: none; }
	h2 a:hover { color: var(--accent); }
	p { margin: 0; color: var(--muted); }
</style>

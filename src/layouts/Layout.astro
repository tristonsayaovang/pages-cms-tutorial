---
import site from '../data/site.json';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header>
			<a class="brand" href="/">{site.title}</a>
			<p class="tagline">{site.tagline}</p>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p>{site.footer} · © {new Date().getFullYear()} {site.author}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fdfcfa;
		--text: #1d1d1f;
		--muted: #6b6b70;
		--accent: #6b5bff;
		--border: #e6e3dd;
		color-scheme: light dark;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #141416;
			--text: #ececef;
			--muted: #9a9aa2;
			--accent: #9d92ff;
			--border: #2b2b30;
		}
	}
	* { box-sizing: border-box; }
	body {
		margin: 0 auto;
		max-width: 44rem;
		padding: 2rem 1rem 4rem;
		background: var(--bg);
		color: var(--text);
		font: 1.0625rem/1.65 system-ui, -apple-system, 'Segoe UI', sans-serif;
	}
	a { color: var(--accent); }
	img { max-width: 100%; height: auto; border-radius: 0.5rem; }
	header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
	.brand { font-size: 1.5rem; font-weight: 700; color: var(--text); text-decoration: none; }
	.tagline { margin: 0.25rem 0 0; color: var(--muted); }
	footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.875rem; }
	time { color: var(--muted); font-size: 0.875rem; }
</style>
